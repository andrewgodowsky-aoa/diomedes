{
  "openapi": "3.1.0",
  "info": {
    "title": "Helpdesk Tickets Fixture API",
    "version": "2.1.0"
  },
  "paths": {
    "/tickets": {
      "get": {
        "operationId": "listTickets",
        "summary": "List helpdesk tickets in one queue.",
        "parameters": [
          {
            "name": "queueId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "enum": ["support", "billing"]
            }
          },
          {
            "name": "state",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["open", "closed"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A bounded helpdesk ticket result.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "queueId": { "type": "string" },
                    "tickets": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string" },
                          "title": { "type": "string" },
                          "priority": {
                            "type": "string",
                            "enum": ["low", "normal", "urgent"]
                          },
                          "state": {
                            "type": "string",
                            "enum": ["open", "closed"]
                          }
                        },
                        "required": ["id", "title", "priority", "state"],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": ["queueId", "tickets"],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    }
  }
}
