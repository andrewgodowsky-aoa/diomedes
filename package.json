{
  "name": "diomedes",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "service": "tsx server/index.ts",
    "client": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc --noEmit && vite build",
    "postbuild": "node --use-system-ca scripts/package-desktop.mjs",
    "start": "tsx server/index.ts --production",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "probe:team": "tsx scripts/team-probe.ts",
    "fixtures": "tsx scripts/fixtures.ts",
    "prepare-native": "tsx scripts/prepare-native.ts",
    "test:ui": "playwright test",
    "verify:native-work": "tsx scripts/native-work-smoke.ts",
    "smoke:team-codex": "node scripts/team-codex-smoke.mjs",
    "package:desktop": "npm run build",
    "test:desktop": "node scripts/desktop-smoke.mjs",
    "test:desktop-reviewer": "node scripts/reviewer-desktop-smoke.mjs"
  },
  "dependencies": {
    "@fontsource/big-shoulders-display": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-serif": "^5.2.7",
    "@fontsource/schibsted-grotesk": "^5.2.8",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "diff": "^8.0.2",
    "express": "^5.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@playwright/test": "^1.55.0",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "electron": "^44.2.0",
    "esbuild": "^0.28.2",
    "prettier": "3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  }
}
