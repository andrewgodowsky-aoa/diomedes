  "statements": [
    {
      "id": "product-authority",
      "scopes": ["product"],
      "text": "Diomedes stages model output as a proposal and applies project-file changes through its guarded Store and History path after the applicable authority decision.",
      "sources": ["server/native-work.ts", "server/store.ts", "server/trust.ts"]
    },
    {
      "id": "product-readiness",
      "scopes": ["product"],
      "text": "Present-tense availability requires separate implemented, installed, authorized, verified and healthy evidence; a missing or stale axis remains unknown or blocks readiness.",
      "sources": ["shared/readiness.ts", "server/readiness/projection.ts"]
    },
    {
      "id": "route-sample",
      "scopes": ["route:sample"],
      "text": "The sample route is a deterministic in-process staged worker with no model, tool or network call.",
      "sources": ["server/work.ts", "server/harness/route-contract.ts", "server/harness/adapters.ts"]
    },
    {
      "id": "route-text-limit",
      "scopes": ["route:claude-code", "route:opencode", "route:oh-my-pi", "route:cursor", "route:devin"],
      "text": "Single-turn text routes start a fresh request and do not expose native follow-up, resume, fork or reconciliation sessions. Native follow-up, resume and fork exist on the separate opt-in Claude Code session route.",
      "sources": ["server/harness/route-contract.ts", "server/engines/service.ts"]
    },
    {
      "id": "route-text-containment",
      "scopes": ["route:claude-code", "route:opencode", "route:oh-my-pi", "route:cursor", "route:devin"],
      "text": "The host enforces project file proposals and approvals, while operating-system sandbox parity is not claimed for these text adapters.",
      "sources": ["server/harness/adapters.ts", "shared/engines.ts", "server/native-work.ts"]
    },
    {
      "id": "route-session",
      "scopes": ["route:claude-code-session"],
      "text": "The opt-in Claude Code session route holds one persistent process across turns, so follow-up, resume and fork are native there; active-turn steering and provider reconciliation are refused, and a session turn carries only ask or plan mode.",
      "sources": ["server/harness/route-contract.ts", "server/engines/claude-session-routes.ts"]
    },
    {
      "id": "route-switch",
      "scopes": ["product"],
      "text": "Diomedes does not automatically switch a selected readiness workflow to another route; a different route requires an explicit choice.",
      "sources": ["server/readiness/projection.ts"]
    }
  ]
}
