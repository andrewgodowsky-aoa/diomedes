{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "diomedes",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-19",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "dev": { "ip": "127.0.0.1", "port": 8791, "local_protocol": "http" },
  // Refuses until exact authorized provider metadata, origins and secrets exist.
  "vars": { "ENVIRONMENT": "staging", "ALLOWED_ORIGINS": "", "WORKOS_CLIENT_ID": "", "WORKOS_ISSUER": "", "WORKOS_TOKEN_AUDIENCE": "" },
  // Managed inference (/managed/v1/*, contract nectovia-managed/1) reads one more secret at call
  // time: BEDROCK_API_KEY, a Bedrock long-term API key for the company's AWS account, sent only to
  // the endpoint in src/managed-providers.ts. The owner sets it; it is never written here. Until it
  // is set, every managed call answers 503 route_unavailable and nothing is held or sent.
  "secrets": { "required": ["DATABASE_URL", "WORKOS_API_KEY"] }
}
