{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "diomedes",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-19",
  "workers_dev": false,
  "preview_urls": false,
  // The company account service. Staging data until production is approved.
  "routes": [{ "pattern": "accounts.diomedes.net", "custom_domain": true }],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  // The phone relay (2026-09-26): one hub per business, the Durable Object class RelayHub that
  // src/worker.ts exports, named by the business's organization id. The first deploy with this
  // migration creates the class, SQLite-backed. The repository root's wrangler.jsonc says the same.
  "durable_objects": { "bindings": [{ "name": "RELAY_HUB", "class_name": "RelayHub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RelayHub"] }],
  "dev": { "ip": "127.0.0.1", "port": 8791, "local_protocol": "http" },
  // Refuses (503) until WORKOS_CLIENT_ID is set here and both required secrets exist. The
  // client ID is public; it goes here, not in the dashboard, so a deploy keeps it.
  // The audience is the resource the WorkOS application's JWT template adds.
  // Two WorkOS environments, each with its own branded sign-in, users and keys:
  // - WORKOS_CLIENT_ID and the secret WORKOS_API_KEY: customers (Nectovia), for /account/* and
  //   /managed/*.
  // - STAFF_WORKOS_CLIENT_ID and the secret STAFF_WORKOS_API_KEY: staff (Diomedes Systems), the
  //   only environment /ops/* accepts. Until both are set, and differ from the customer
  //   environment's client and key, every /ops/* call answers 503. Customer routes don't read them.
  //   The staff environment uses the same issuer and the same JWT template audience.
  // The two MANAGED_* values are the owner's testing limits of 2026-09-25: $100 in provider cost
  // for all staging testing, for all time, and short answers. Raise them only on his word.
  "vars": {
    "ENVIRONMENT": "staging",
    "ALLOWED_ORIGINS": "https://accounts.diomedes.net",
    "WORKOS_CLIENT_ID": "client_01M2CX1HZ8RDE8EYGG2YCDX39H",
    "WORKOS_ISSUER": "https://api.workos.com",
    "WORKOS_TOKEN_AUDIENCE": "https://accounts.diomedes.net",
    "STAFF_WORKOS_CLIENT_ID": "client_01M3E6R03GCWVQPV3FWZJSDVQW",
    "MANAGED_SPEND_CEILING_MICRO_USD": "100000000",
    "MANAGED_MAX_OUTPUT_TOKENS": "2000",
    // The approved provider connections (providerConnectionSchema in shared/routing-policy.ts), as one
    // JSON string. Each names the Worker secret it reads, never its value: AZURE_OPENAI_API_KEY for
    // Azure AI Foundry diomedes-foundry-dev-rg (gpt-6.1-sol, gpt-6-luna, claude-opus-5-5),
    // BEDROCK_API_KEY for Bedrock us-east-1 (us.moonshotai.kimi-k3), OPENROUTER_API_KEY for four exact
    // OpenRouter endpoints, and VERTEX_API_KEY for Vertex project diomedes-dev (Google models, global).
    // A connection whose secret is unset serves nothing. Operations saves routes against these ids;
    // changing a connection means a new revision, and its routes are saved again.
    "MANAGED_CONNECTIONS": "[{\"id\":\"azure-foundry-dev\",\"revision\":1,\"label\":\"Azure AI Foundry (diomedes-foundry-dev-rg)\",\"secretRef\":\"AZURE_OPENAI_API_KEY\",\"payer\":\"company\",\"account\":\"Azure resource diomedes-foundry-dev-rg, project diomedes-dev\",\"enabled\":true,\"provider\":\"azure-openai\",\"resource\":\"diomedes-foundry-dev-rg\",\"apiVersion\":\"v1\",\"host\":\"services.ai.azure.com\",\"deployments\":[\"gpt-6.1-sol\",\"gpt-6-luna\",\"claude-opus-5-5\"]},{\"id\":\"aws-bedrock-us-east-1\",\"revision\":1,\"label\":\"Amazon Bedrock (us-east-1)\",\"secretRef\":\"BEDROCK_API_KEY\",\"payer\":\"company\",\"account\":\"Diomedes Systems AWS account\",\"enabled\":true,\"provider\":\"aws-bedrock\",\"region\":\"us-east-1\",\"endpointFamily\":\"runtime\",\"allowedProfiles\":[\"us.moonshotai.kimi-k3\"],\"modelProtocols\":{\"us.moonshotai.kimi-k3\":[\"chat-completions\"]}},{\"id\":\"openrouter\",\"revision\":1,\"label\":\"OpenRouter\",\"secretRef\":\"OPENROUTER_API_KEY\",\"payer\":\"company\",\"account\":\"Diomedes Systems OpenRouter account\",\"enabled\":true,\"provider\":\"openrouter\",\"ingress\":\"global\",\"regionalEntitlement\":false,\"allowedEndpoints\":[\"deepinfra/fp8\",\"baseten/fp8\",\"fireworks/us\",\"sail-research/us\"],\"endpointNames\":{\"deepinfra/fp8\":\"DeepInfra\",\"baseten/fp8\":\"BaseTen\",\"fireworks/us\":\"Fireworks\",\"sail-research/us\":\"Sail Research\"}},{\"id\":\"vertex-diomedes-dev\",\"revision\":1,\"label\":\"Google Vertex AI (diomedes-dev)\",\"secretRef\":\"VERTEX_API_KEY\",\"payer\":\"company\",\"account\":\"Google Cloud project diomedes-dev\",\"enabled\":true,\"provider\":\"google-vertex\",\"project\":\"diomedes-dev\",\"location\":\"global\",\"publisher\":\"google\"}]"
  },
  // Managed inference (/managed/v1/*, contract nectovia-managed/1) reads two more secrets at call
  // time. The owner sets both; neither is ever written here. Until both are set, every managed
  // call answers 503 route_unavailable and nothing is held or sent. The account routes need neither.
  // - BEDROCK_API_KEY: a Bedrock long-term API key for the company's AWS account, sent only to the
  //   endpoint in src/managed-providers.ts.
  // - FUNDING_DATABASE_URL: the login cp_funding (scripts/funding-permissions.sql), on the same
  //   host and database as DATABASE_URL. Only the gateway's credit periods, jobs, holds and
  //   settlements use it; DATABASE_URL's cp_runtime may only read funding rows. Set it with
  //   `npx wrangler secret put FUNDING_DATABASE_URL --name diomedes`.
  // Typed evaluations (/managed/v1/evaluations) also read OPENROUTER_API_KEY, sent only to the
  // OpenRouter endpoint in src/managed-providers.ts. Without it that route alone answers 503
  // route_unavailable. Set it with `npx wrangler secret put OPENROUTER_API_KEY --name diomedes`.
  //
  // Two optional spend settings are read at call time beside them (whole numbers; unset or blank is
  // off; anything unreadable refuses every managed call with 503 route_unavailable):
  // - MANAGED_SPEND_CEILING_MICRO_USD: the most the company's provider account may owe, all
  //   tenants and organizations, for all time: settled provider cost plus every pending,
  //   uncertain or written-off hold in full plus the new call's hold. A call that would pass it
  //   is refused before any hold with 503 route_unavailable ("Nothing was charged"). It counts
  //   this Worker's database only. Staging runs with 100000000 ($100). Production default: unset.
  // - MANAGED_MAX_OUTPUT_TOKENS: lowers the registry's per-route output cap (16,000), never
  //   raises it. Larger requests are clamped silently and the clamp is named in the response
  //   header X-Nectovia-Max-Output. Testing runs with 2000.
  // Both are set in "vars" above for staging. A production environment sets its own.
  // Workers Builds deploys the repository root's wrangler.jsonc, which must carry the same routes
  // and vars as this file (tests/deploy-config.test.ts).
  "secrets": { "required": ["DATABASE_URL", "WORKOS_API_KEY"] }
}
