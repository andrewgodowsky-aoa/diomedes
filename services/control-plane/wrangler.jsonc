{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "diomedes",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-19",
  "workers_dev": false,
  "preview_urls": false,
  // The company account service. Staging data until production is approved.
  "routes": [{ "pattern": "accounts.diomedes.net", "custom_domain": true }],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "dev": { "ip": "127.0.0.1", "port": 8791, "local_protocol": "http" },
  // Refuses (503) until WORKOS_CLIENT_ID is set here and both required secrets exist. The
  // client ID is public; it goes here, not in the dashboard, so a deploy keeps it.
  // The audience is the resource the WorkOS application's JWT template adds.
  // The two MANAGED_* values are the owner's testing limits of 2026-09-25: $100 in provider cost
  // for all staging testing, for all time, and short answers. Raise them only on his word.
  "vars": {
    "ENVIRONMENT": "staging",
    "ALLOWED_ORIGINS": "https://accounts.diomedes.net",
    "WORKOS_CLIENT_ID": "",
    "WORKOS_ISSUER": "https://api.workos.com",
    "WORKOS_TOKEN_AUDIENCE": "https://accounts.diomedes.net",
    "MANAGED_SPEND_CEILING_MICRO_USD": "100000000",
    "MANAGED_MAX_OUTPUT_TOKENS": "2000"
  },
  // Managed inference (/managed/v1/*, contract nectovia-managed/1) reads two more secrets at call
  // time. The owner sets both; neither is ever written here. Until both are set, every managed
  // call answers 503 route_unavailable and nothing is held or sent. The account routes need neither.
  // - BEDROCK_API_KEY: a Bedrock long-term API key for the company's AWS account, sent only to the
  //   endpoint in src/managed-providers.ts.
  // - FUNDING_DATABASE_URL: the login cp_funding (scripts/funding-permissions.sql), on the same
  //   host and database as DATABASE_URL. Only the gateway's credit periods, jobs, holds and
  //   settlements use it; DATABASE_URL's cp_runtime may only read funding rows. Set it with
  //   `npx wrangler secret put FUNDING_DATABASE_URL --name diomedes`.
  //
  // Two optional spend settings are read at call time beside them (whole numbers; unset or blank is
  // off; anything unreadable refuses every managed call with 503 route_unavailable):
  // - MANAGED_SPEND_CEILING_MICRO_USD: the most the company's provider account may owe, all
  //   tenants and organizations, for all time: settled provider cost plus every pending,
  //   uncertain or written-off hold in full plus the new call's hold. A call that would pass it
  //   is refused before any hold with 503 route_unavailable ("Nothing was charged"). It counts
  //   this Worker's database only. Staging runs with 100000000 ($100). Production default: unset.
  // - MANAGED_MAX_OUTPUT_TOKENS: lowers the registry's per-route output cap (16,000), never
  //   raises it. Larger requests are clamped silently and the clamp is named in the response
  //   header X-Nectovia-Max-Output. Testing runs with 2000.
  // Both are set in "vars" above for staging. A production environment sets its own.
  // Workers Builds deploys the repository root's wrangler.jsonc, which must carry the same routes
  // and vars as this file (tests/deploy-config.test.ts).
  "secrets": { "required": ["DATABASE_URL", "WORKOS_API_KEY"] }
}
